# Server-only configuration. Never use NEXT_PUBLIC_ for API keys.
# Copy to .env for local use; configure secrets separately on your hosting platform.
# Lessons, quizzes, model answers, audio playback and local recording work without AI.

# One Microsoft Foundry resource supplies OpenAI, Voice Live, and Speech.
# Project: https://main-azure-backup-resource.services.ai.azure.com/api/projects/main-azure-backup
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://main-azure-backup-resource.openai.azure.com/openai/v1
AZURE_OPENAI_FEEDBACK_MODEL=gpt-6-luna

# Azure Speech Voice Live. The server proxies its WebSocket so the shared key
# never reaches the browser.
AZURE_VOICELIVE_ENDPOINT=https://main-azure-backup-resource.services.ai.azure.com
AZURE_VOICELIVE_MODEL=gpt-realtime-2.1-mini
AZURE_VOICELIVE_VOICE=sv-SE-MattiasNeural
AZURE_VOICELIVE_API_VERSION=2026-01-01-preview

# Optional local bind address. This keeps localhost available when another
# development app already occupies the IPv4 side of port 3000.
# HOST=::

# Azure Speech fast transcription. Use the Speech endpoint for your resource.
# This is separate from the /openai/v1 model endpoint and has no project path.
AZURE_SPEECH_ENDPOINT=https://main-azure-backup-resource.services.ai.azure.com
# Speech reuses AZURE_OPENAI_API_KEY. Add AZURE_SPEECH_API_KEY only if Speech
# is later moved to a different Azure resource.
AZURE_SPEECH_API_VERSION=2025-10-15

# Azure Speech text-to-speech endpoint. A Foundry/Speech custom-domain base URL
# is supported and the app adds /tts/cognitiveservices/v1 for REST synthesis.
# The same resource key above is reused when AZURE_SPEECH_API_KEY is empty.
AZURE_SPEECH_TTS_ENDPOINT=https://main-azure-backup-resource.cognitiveservices.azure.com/
