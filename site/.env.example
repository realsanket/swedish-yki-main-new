# Server-only configuration. Never use NEXT_PUBLIC_ for API keys.
# Copy to .env for local use; configure secrets separately on your hosting platform.
# Lessons, quizzes, model answers, audio playback and local recording work without AI.

# Microsoft Azure / Foundry. Primary and backup must use the same deployment
# names; only their endpoint and resource key change.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://main-ai-foundry-3103.openai.azure.com/openai/v1
AZURE_OPENAI_FEEDBACK_MODEL=gpt-6-luna
AZURE_OPENAI_VOICE_MODEL=gpt-live-1

# Optional backup resource. A separate key is required because this is a
# different Azure resource. It reuses both model names declared above.
AZURE_OPENAI_BACKUP_BASE_URL=https://main-azure-backup-resource.openai.azure.com/openai/v1
AZURE_OPENAI_BACKUP_API_KEY=

# Azure Speech fast transcription. Use the Speech endpoint for your resource.
# This is separate from the /openai/v1 model endpoint and has no project path.
AZURE_SPEECH_ENDPOINT=https://main-ai-foundry-3103.services.ai.azure.com
# Speech reuses AZURE_OPENAI_API_KEY. Add AZURE_SPEECH_API_KEY only if Speech
# is later moved to a different Azure resource.
AZURE_SPEECH_API_VERSION=2025-10-15

# Azure Speech text-to-speech endpoint. A Foundry/Speech custom-domain base URL
# is supported and the app adds /tts/cognitiveservices/v1 for REST synthesis.
# The same resource key above is reused when AZURE_SPEECH_API_KEY is empty.
AZURE_SPEECH_TTS_ENDPOINT=https://YOUR_RESOURCE.cognitiveservices.azure.com/
